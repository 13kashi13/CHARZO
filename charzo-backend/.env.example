# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/charzo

# JWT
JWT_SECRET_KEY=your-256-bit-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
FRONTEND_ORIGIN=https://charzo.vercel.app

# App
ENVIRONMENT=development

# Optional — if set, /health requires this key in production
HEALTH_API_KEY=
